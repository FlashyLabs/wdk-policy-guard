{
  "name": "@flashylabs/wdk-policy-guard",
  "version": "0.1.2",
  "description": "A spending-policy layer for wallets built on Tether's WDK (or any wallet SDK): grade a transfer against a per-agent envelope — kind, chain, asset and destination allowlists, a per-transaction cap, a daily cap, an auto-approve ceiling — before it signs. ALLOW, ESCALATE or DENY, with a reason.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapters/wdk": {
      "types": "./dist/adapters/wdk.d.ts",
      "default": "./src/adapters/wdk.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "manifest": "node src/manifest.js --write",
    "check": "node src/manifest.js --check",
    "version": "npm run manifest && git add wdk-policy-guard.manifest.json",
    "build:types": "tsc -p tsconfig.json",
    "test:types": "npm run build:types && tsc -p test-types/tsconfig.json",
    "prepublishOnly": "npm run build:types"
  },
  "keywords": [
    "wdk",
    "tether",
    "wallet",
    "policy",
    "guardrails",
    "agent",
    "spending-limits",
    "crypto",
    "web3"
  ],
  "author": "Flashy Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashyLabs/wdk-policy-guard.git"
  },
  "homepage": "https://github.com/FlashyLabs/wdk-policy-guard#readme",
  "bugs": {
    "url": "https://github.com/FlashyLabs/wdk-policy-guard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
